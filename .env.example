# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables for BOTH Production and Preview.

# Required at runtime (the build no longer needs it). Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction"
# pooler (port 6543) for Vercel; the direct connection (5432) is fine locally.
# Local example: postgres://postgres:postgres@localhost:5432/upcreate
DATABASE_URL=

# Required. Signs the login session cookie. Generate: openssl rand -base64 32
SESSION_SECRET=

# Recommended. Encrypts stored AI provider keys (AES-256-GCM). Falls back to
# SESSION_SECRET. Changing it makes stored keys unreadable (re-enter them in
# Settings).
ENCRYPTION_KEY=

# Optional. The app is single-owner: signup closes after the first account.
# Set to true to allow more accounts.
SIGNUP_OPEN=

# Optional fallback AI key, used when no key is saved in Settings. Every
# generator also works without any key via "Copy prompt".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Only for `npm test`: a throwaway database for the bulk-delete test.
TEST_DATABASE_URL=
